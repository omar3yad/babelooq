# Core Configurations
DATABASE_URL=sqlite+aiosqlite:///./pgms.db # Database connection URL (e.g. sqlite+aiosqlite:///./pgms.db for SQLite or postgresql+asyncpg://... for PostgreSQL)
SECRET_KEY=change-this-to-a-very-secure-random-32-character-key-value-here # Secret key for signing JWT tokens (must be at least 32 characters)
ENVIRONMENT=development # Application deployment environment (development, staging, production)
JWT_EXPIRE_HOURS=8 # JWT access token expiry duration in hours (integer, >= 1)
JWT_ALGORITHM=HS256 # Cryptographic algorithm to sign JWT (default HS256)
DEBUG=True # Enable debug mode in FastAPI (must be False if ENVIRONMENT is production)
APP_NAME=PGMS # Application display name

# Database Connection Pool Configurations (ignored for SQLite)
DB_POOL_SIZE=5 # Database connection pool size (integer)
DB_MAX_OVERFLOW=10 # Database connection pool max overflow (integer)

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:8000"] # Allowed origins for CORS (JSON-serialized list of strings, wildcard '*' forbidden in production)

# Seed Administrator Account Configurations
SEED_ADMIN_USERNAME=admin # Username for seeded admin
SEED_ADMIN_PASSWORD=admin_secure_password_1234 # Password for seeded admin (must be hashed on seed)
SEED_ADMIN_FULL_NAME=مدير النظام # Full name of the seeded admin

# Seed Gate Operator Accounts Configurations
SEED_OP_1_USERNAME=operator_1 # Username for Operator 1 (Gate 1)
SEED_OP_1_PASSWORD=op_secure_password_1 # Password for Operator 1
SEED_OP_1_FULL_NAME=عامل البوابة الأولى # Full name of Operator 1

SEED_OP_2_USERNAME=operator_2 # Username for Operator 2 (Gate 2)
SEED_OP_2_PASSWORD=op_secure_password_2 # Password for Operator 2
SEED_OP_2_FULL_NAME=عامل البوابة الثانية # Full name of Operator 2

SEED_OP_3_USERNAME=operator_3 # Username for Operator 3 (Gate 3)
SEED_OP_3_PASSWORD=op_secure_password_3 # Password for Operator 3
SEED_OP_3_FULL_NAME=عامل البوابة الثالثة # Full name of Operator 3

SEED_OP_4_USERNAME=operator_4 # Username for Operator 4 (Gate 4)
SEED_OP_4_PASSWORD=op_secure_password_4 # Password for Operator 4
SEED_OP_4_FULL_NAME=عامل البوابة الرابعة # Full name of Operator 4

SEED_OP_5_USERNAME=operator_5 # Username for Operator 5 (Gate 5)
SEED_OP_5_PASSWORD=op_secure_password_5 # Password for Operator 5
SEED_OP_5_FULL_NAME=عامل البوابة الخامسة # Full name of Operator 5
# Edge plate recognition (garage PC connects to wss://<domain>/ws/edge).
# Leave EDGE_API_TOKEN unset to disable. Generate with: openssl rand -hex 32
EDGE_API_TOKEN=
PLATE_CAPTURE_TIMEOUT_S=4.0 # Hard server-side deadline for a plate result (target ~1.5s)
PLATE_POLL_MAX_WAIT_S=6.0 # Max hold time of one dashboard long-poll request
EDGE_PRESENCE_TTL_S=30 # Edge considered offline after this many seconds without heartbeat
PLATE_IMAGE_DIR=media/plates # Where WebP snapshots are stored (relative to app dir)
PLATE_IMAGE_MAX_BYTES=1500000
