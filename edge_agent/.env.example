# Copy to edge_agent/.env on the garage PC (run the agent from its parent folder).
EDGE_SERVER_URL=wss://babelooq.garage4u.io/ws/edge
# Must equal EDGE_API_TOKEN in the VPS .env (>= 32 chars, e.g. `openssl rand -hex 32`)
EDGE_API_TOKEN=
EDGE_NODE_ID=garage-edge-1

# gate_id -> camera snapshot URL (Hikvision example; Dahua: /cgi-bin/snapshot.cgi)
EDGE_CAMERAS={"1": "http://192.168.1.64/ISAPI/Streaming/channels/101/picture"}
EDGE_CAMERA_AUTH=digest
EDGE_CAMERA_USERNAME=admin
EDGE_CAMERA_PASSWORD=
EDGE_SNAPSHOT_TIMEOUT_S=0.8

EDGE_DETECTOR_WEIGHTS=models/plate_yolo.pt
EDGE_OCR_LANGS=["ar"]
EDGE_USE_GPU=false
EDGE_MIN_DETECTION_CONFIDENCE=0.35

EDGE_WEBP_QUALITY=70
EDGE_WEBP_MAX_WIDTH=1024
EDGE_LOG_LEVEL=INFO
